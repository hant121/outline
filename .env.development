# Local development overrides (loaded when NODE_ENV=development)
# See: https://docs.getoutline.com/s/hosting/doc/local-development-5hEhFRXow7
URL=https://local.outline.dev:3000

DATABASE_URL=postgres://user:pass@127.0.0.1:5432/outline
REDIS_URL=redis://127.0.0.1:6379

SMTP_FROM_EMAIL=hello@example.com

# Enable unsafe-inline in script-src CSP directive
# Setting it to true allows React dev tools add-on in Firefox to successfully detect the project
DEVELOPMENT_UNSAFE_INLINE_CSP=true

# Increase the log level to debug for development
LOG_LEVEL=debug

# Local SSL via mkcert (server/config/certs)
FORCE_HTTPS=true

# Trust mkcert CA so Node can talk to HTTPS MinIO
NODE_EXTRA_CA_CERTS=C:/Users/capta/AppData/Local/mkcert/rootCA.pem

# MinIO local with HTTPS (avoids mixed-content blocking image display)
#
# Console: https://minio.outline.dev:9001  (minioadmin / minioadmin)
# API:     https://minio.outline.dev:9000  bucket: outline
#
# Start deps:
#   docker compose up -d redis postgres minio
#   docker compose run --rm minio-init
FILE_STORAGE=s3
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
AWS_REGION=us-east-1
AWS_S3_UPLOAD_BUCKET_NAME=outline
AWS_S3_UPLOAD_BUCKET_URL=https://minio.outline.dev:9000
AWS_S3_FORCE_PATH_STYLE=true
AWS_S3_ACL=private
AWS_S3_UPLOAD_METHOD=put
ALLOWED_PRIVATE_IP_ADDRESSES=10.156.8.56,127.0.0.1
